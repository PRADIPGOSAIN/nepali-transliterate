c --- 5. digits ---
  + '0' > '०'
  + '1' > '१'
  + '2' > '२'
  + '3' > '३'
  + '4' > '४'
  + '5' > '५'
  + '6' > '६'
  + '7' > '७'
  + '8' > '८'
  + '9' > '९'

c --- 6. punctuation / signs ---
c NOTE: M/N are always anusvara here (mim-faithful). Type lowercase
c m/n at word start for म/न. (kmc rejects nul in this position.)
  + '..' > '॥'
  + '.' > '।'
  + '~a' > 'ऽ'
  + '*' > 'ँ'
  + 'H' > 'ः'
  + 'M' > 'ं'
  + 'N' > 'ं'
  + '\\' > '्‌'
  + '|' > '‌्‍'
  + '~' > '।'

