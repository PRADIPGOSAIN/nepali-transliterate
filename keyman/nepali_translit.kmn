store(&VERSION) '10.0'
store(&KEYBOARDVERSION) '0.11.0'
store(&NAME) 'Nepali Transliterate'
store(&COPYRIGHT) 'GPL-2.0-or-later'
store(&MESSAGE) 'Romanized Nepali: type namaste -> \U0928\U092E\U0938\U094D\U0924\U0947'
store(&TARGETS) 'any'
c (language is declared in the .kps package file, not here)

c (plain rules only: no stores needed)

begin Unicode > use(main)

group(main) using keys

c --- 1. multi-char consonant clusters, longest first ---
  + 'ksh' > 'क्ष'
  + 'chh' > 'छ'
  + 'th/' > 'ठ'
  + 'dh/' > 'ढ'
  + 'shh' > 'ष'
  + 'gyn' > 'ज्ञ'
